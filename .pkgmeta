# CurseForge / BigWigs packager config. package-as MUST equal the TOC name (MoveMyBags.Kuro.toc); without
# it CurseForge would name the zip folder after the project slug (movemybags-kuro) and the game
# would not load the addon. The CurseForge project is "MoveMyBags-Kuro" (id 1810896) only because
# "MoveMyBags" (the upstream addon) is taken there.
package-as: MoveMyBags.Kuro

enable-nolib-creation: no

manual-changelog: CHANGELOG.md

ignore:
  - README.md
  - .github
  - .gitignore
  - .pkgmeta